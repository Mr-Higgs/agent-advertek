{
  "name": "@advertek/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build:deps": "pnpm --dir ../.. -r --filter '@advertek/web^...' --if-present build",
    "build": "pnpm run build:deps && next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint app components lib",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@advertek/catalog": "workspace:*",
    "@advertek/db": "workspace:*",
    "@advertek/fulfillment": "workspace:*",
    "@advertek/mcp-server": "workspace:*",
    "@advertek/payments": "workspace:*",
    "@advertek/quote-api": "workspace:*",
    "@advertek/types": "workspace:*",
    "@advertek/webhooks": "workspace:*",
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/react": "^4.0.88",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.85",
    "lucide-react": "^1.29.0",
    "mcp-handler": "^1.1.0",
    "next": "16.2.11",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "vitest": "^3.2.4"
  }
}
