# Solana / payments (devnet testing)
QUICKNODE_RPC_URL=
USDC_MINT_ADDRESS=
ADVERTEK_SETTLEMENT_WALLET=

# QuickNode Streams/Functions webhook receiver (packages/payments)
# Security token from the Stream/Function's settings in the QuickNode
# dashboard; used to verify the HMAC-SHA256 signature on incoming webhooks.
QUICKNODE_WEBHOOK_SECURITY_TOKEN=

# Treasury (packages/treasury): moves accumulated USDC into OKX and
# converts it to CAD. Reuses QUICKNODE_RPC_URL / USDC_MINT_ADDRESS /
# ADVERTEK_SETTLEMENT_WALLET above to read the settlement wallet's balance
# and on-chain payment history.

# Secret key (JSON byte array, as produced by `solana-keygen`) that can move
# funds OUT of the settlement wallet. Only needed by the sweep's on-chain
# deposit-to-OKX step — never required just to read balances/history.
SETTLEMENT_WALLET_SECRET_KEY=

# OKX read/trade API credentials — checks balances and executes Convert
# (USDC -> CAD) only. Kept separate from the withdrawal credentials below so
# a compromised or misused trading key can never move funds out of OKX.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_API_BASE_URL=https://www.okx.com
# Set to true when OKX_API_KEY above is a Demo Trading key (created under
# Trade -> Demo Trading -> Personal Center -> Demo Trading API). Adds the
# required `x-simulated-trading: 1` header to every request. Leave unset/
# false for real production keys.
OKX_API_DEMO=

# OKX withdrawal-permission credentials — a distinct API key/secret/
# passphrase set, scoped to withdrawals only in the OKX dashboard. The
# automatic sweep never uses these; getting fiat out of OKX stays a
# deliberate, separate action.
OKX_WITHDRAWAL_API_KEY=
OKX_WITHDRAWAL_API_SECRET=
OKX_WITHDRAWAL_API_PASSPHRASE=
OKX_WITHDRAWAL_API_BASE_URL=https://www.okx.com

# How often the sweep scheduler runs, and the minimum accumulated USDC
# (base units, 6 decimals) required before it actually sweeps. Both have
# sane defaults (6 hours; 0 = sweep whatever is new every interval).
SWEEP_INTERVAL_MS=
SWEEP_MIN_USDC_BASE_UNITS=

# Reconciliation tolerance: an order's fiat allocation is flagged as
# out-of-tolerance if it deviates from its expected share by more than
# max(floor, expected * bps / 10000). Defaults: 50 bps (0.5%), 1 cent floor.
RECONCILIATION_TOLERANCE_BPS=
RECONCILIATION_TOLERANCE_FLOOR_CENTS=

# Advertek order-fulfillment API (packages/fulfillment). HTTP Basic Auth
# over HTTPS only (http:// is accepted only for localhost/127.0.0.1/::1,
# for local mock-server testing).
#
# ADVERTEK_API_BASE_URL: leave unset outside production to use the
# built-in staging default — see ADVERTEK_STAGING_BASE_URL in
# packages/fulfillment/src/config.ts (never duplicated as a literal here).
# In production (NODE_ENV=production) it must be set explicitly; config
# loading fails fast if it's missing there.
#
# ADVERTEK_API_USERNAME / ADVERTEK_API_PASSWORD: required — and config
# loading fails fast if either is missing — whenever the effective base
# URL (explicit or defaulted) is a non-local host. No default/fallback
# value is ever set for either.
ADVERTEK_API_USERNAME=
ADVERTEK_API_PASSWORD=
ADVERTEK_API_BASE_URL=

# Advertek inbound order-status webhook (packages/fulfillment). Advertek
# authenticates its webhook deliveries to us via HTTP Basic Auth using
# these credentials — a distinct credential set from ADVERTEK_API_* above,
# since it authenticates the opposite direction of the integration. This
# receiving endpoint must be served over HTTPS only.
ADVERTEK_WEBHOOK_USERNAME=
ADVERTEK_WEBHOOK_PASSWORD=

# Advertek pricing + CAD->USDC spot rate (packages/quote-api). Both are
# optional: when an endpoint is unset the app falls back to the inspection
# mock and labels every figure as demo pricing. When ADVERTEK_PRICING_API_URL
# is set, ADVERTEK_PRICING_API_KEY is required (a half-configured integration
# fails fast rather than silently quoting mock prices). https:// only, except
# localhost/127.0.0.1/::1 for local mock servers.
ADVERTEK_PRICING_API_URL=
ADVERTEK_PRICING_API_KEY=
SPOT_RATE_API_URL=
SPOT_RATE_API_KEY=

# Agent API keys for the write/quote surface (/api/quotes, /api/orders,
# /api/mcp) — request-authorization secrets only, never money-moving
# credentials. Comma-separated; auth turns on automatically as soon as any
# key is present. Set ADVERTEK_API_AUTH_REQUIRED=false to keep a keyless
# public demo open, or =true to fail closed until keys are provisioned.
# /api/catalog stays public.
ADVERTEK_API_KEYS=
ADVERTEK_API_AUTH_REQUIRED=
# Per-instance fixed-window rate limit for those routes (default 60).
RATE_LIMIT_REQUESTS_PER_MINUTE=

# Signing secret for outbound order-status webhooks delivered to agent
# callback URLs registered through POST /api/orders. Stored in
# webhook_subscriptions by reference (the env var name), never by value.
AGENT_WEBHOOK_SIGNING_SECRET=

# Postgres persistence (packages/db) — Supabase in deployment. Used by the
# Next.js app's webhook route handlers and by apps/treasury-worker. With
# Supabase's pooler (pgbouncer), prepared statements are disabled
# automatically by createPostgresExecutor.
DATABASE_URL=
